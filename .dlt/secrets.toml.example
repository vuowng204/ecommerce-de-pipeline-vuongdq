#Lưu ý dự án này các biến môi trường đã được cấu hình tại .env, bạn có thể tạo 1 file secrets.toml nếu muốn quản lý riêng các biến môi trường cho dlt.
[destination.filesystem]
bucket_url = "s3://<your-bucket>/<optional-prefix>"

[destination.filesystem.credentials]
aws_access_key_id = "<your-aws-access-key-id>"
aws_secret_access_key = "<your-aws-secret-access-key>"
region_name = "<your-aws-region>"

[destination.redshift.credentials]
database = "<your-redshift-database>"
password = "<your-redshift-password>"
username = "<your-redshift-username>"
host = "<your-redshift-endpoint>"
port = 5439

[destination.redshift]
staging_iam_role = "arn:aws:iam::<account-id>:role/<redshift-copy-role>"
