# ============================================
# AWS Credentials
# ============================================
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_DEFAULT_REGION=<your-aws-region>
AWS_ACCOUNT_ID=<your-aws-account-id>

# ============================================
# S3 / Data Lake
# ============================================
S3_BUCKET_NAME=<your-s3-bucket-name>

# ============================================
# BigQuery (optional, if using GCP)
# ============================================
# GCP_PROJECT=<your-gcp-project-id>
# BQ_DATASET_RAW=<raw-dataset-name>
# GOOGLE_APPLICATION_CREDENTIALS=<path-to-service-account-json>

# ============================================
# PostgreSQL source
# ============================================
POSTGRES_HOST=<postgres-host>
POSTGRES_PORT=5432
POSTGRES_DB=<postgres-database>
POSTGRES_USER=<postgres-username>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_CONNECTION_STRING=postgresql://<postgres-username>:<postgres-password>@<postgres-host>:5432/<postgres-database>
#lưu ý : postgres-host chính là tên service của container postgres trong trường hợp chạy bằng airflow.trong trường hợp chạy bằng riêng ingest và loadcsv trên máy local đổi thành localhost.

# ============================================
# Redshift (used by dbt profile khi chạy bằng airflow)
# ============================================
REDSHIFT_HOST=<redshift-endpoint>
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=<redshift-database>
REDSHIFT_USERNAME=<redshift-username>

# ============================================
# Airflow
# ============================================
FERNET_KEY=<generate-a-fernet-key>
AIRFLOW_UID=50000

# ============================================
# dlt
# ============================================
# Redshift destination
DESTINATION__REDSHIFT__CREDENTIALS__DATABASE=<redshift-database>
DESTINATION__REDSHIFT__CREDENTIALS__PASSWORD=<redshift-password> #bạn có thể lấy mật khẩu từ secretmanger bằng  lệnh make redshift-pass.
DESTINATION__REDSHIFT__CREDENTIALS__USERNAME=<redshift-username>
DESTINATION__REDSHIFT__CREDENTIALS__HOST=<redshift-endpoint>
DESTINATION__REDSHIFT__CREDENTIALS__PORT=5439
DESTINATION__REDSHIFT__STAGING_IAM_ROLE=arn:aws:iam::<aws-account-id>:role/<redshift-copy-role>
DESTINATION__REDSHIFT__CREDENTIALs_REGION_NAME=<aws-region>

# Filesystem staging on S3
DESTINATION__FILESYSTEM__CREDENTIALS__AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
DESTINATION__FILESYSTEM__CREDENTIALS__AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
DESTINATION__FILESYSTEM__BUCKET_URL=s3://<your-s3-bucket-name>/<optional-prefix>
